# ==============================================================================
# Secret Santa Organizer - Environment Variables Configuration
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="app.localhost:3000"

# Local MySQL Database Connection via Prisma ORM
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE (e.g., XAMPP uses empty password)
DATABASE_URL="mysql://root:@localhost:3306/secretsanta"

# Resend API Configuration (for transactional emails)
# Found in: Resend Dashboard -> API Keys
RESEND_API_KEY="re_123456789_abcdefg"
RESEND_FROM_EMAIL="Secret Santa <noreply@yourdomain.com>"

# Stripe Configuration (for premium tier checkout and subscriptions)
# Found in: Stripe Dashboard -> Developers -> API Keys / Webhooks
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51...your_publishable_key"
STRIPE_SECRET_KEY="sk_test_51...your_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_...your_webhook_secret"
STRIPE_PREMIUM_EVENT_PRICE_ID="price_...your_price_id"
